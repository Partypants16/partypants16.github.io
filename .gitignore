# Source spreadsheet for franchise-data.js (see tools/build_franchise_data.py).
# Only the generated data goes on the public site, not the raw file.
Book.xlsx

# The Claude page build: the full, unfiltered session logs. LAN only, never commit.
tools/claude-timeline/dist/

# The Encyclopedia's rendered Confluence section, cached between builds (Coles content: never commit)
tools/claude-timeline/.cache/

# Mermaid for the Encyclopedia tab (3.5 MB): build.py fetches it once (encyclopedia.py)
tools/claude-timeline/vendor/

# Python bytecode (build.py imports todo.py)
__pycache__/

# Parth's raw Spotify export (copied from ai/PAT-AI/Parth_Info/). It has IP
# addresses and devices: never commit it. tools/build_music_data.py turns it
# into music-data.js, which holds only totals and top lists.
_spotify_raw/

# React pages: dependencies (react-src/ is built into music-explorer.js and movie-tracker.js)
react-src/node_modules/
